# Supabase (misma instancia ya activa de FC Soluciones; este módulo solo crea tablas bncr_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Datos de la empresa que origina los pagos (valores por defecto del encabezado tipo 1)
NEXT_PUBLIC_EMPRESA_CEDULA=
NEXT_PUBLIC_EMPRESA_NOMBRE=
# Cuenta cliente de 17 dígitos de la que el banco debita el total del lote
NEXT_PUBLIC_CUENTA_DEBITO=

# Opcional: extracción de facturas en PDF con Gemini (los XML se leen sin API key)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
