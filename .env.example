# Supabase: base de datos ÚNICA y centralizada del portal (este módulo solo agrega tablas nuevas).
# Son las mismas credenciales del FC Enterprise Portal: la sesión se comparte entre las dos apps.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Portal madre: a dónde se manda a quien no tenga sesión.
NEXT_PUBLIC_PORTAL_URL=https://fc-enterprise-portal.vercel.app

# Datos por defecto del encabezado del archivo (se pueden editar en la pantalla del lote).
NEXT_PUBLIC_EMPRESA_NOMBRE=
# Número de cliente/convenio de la empresa ante el BNCR (6 dígitos).
NEXT_PUBLIC_BNCR_NUMERO_CLIENTE=
# Cuenta patronal del BNCR de la que se debita el total del lote (9 dígitos, no el IBAN).
NEXT_PUBLIC_BNCR_CUENTA_ORIGEN=

# Opcional: extracción de facturas en PDF con Gemini (los XML se leen sin API key)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
